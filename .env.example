PROJECT_NAME=""

# Connection string format: https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNSTRING
# Add sslmode=disable on local environment
DATABASE_URL="postgresql://user:password@localhost:5432/database?sslmode=disable"
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

DB_MAX_CONNS="25"
DB_MIN_CONNS="5"
DB_MAX_CONN_LIFETIME="1h"
DB_MAX_CONN_IDLE_TIME="30m"
DB_HEALTH_CHECK_PERIOD="1m"
DB_CONNECT_TIMEOUT="15s"
DB_STATS_LOG_INTERVAL="30s"
DB_SLOW_QUERY_THRESHOLD="200ms"

TEST_DB_PORT_START="15432"
TEST_DB_PORT_END="15499"

PGADMIN_DEFAULT_EMAIL=""
PGADMIN_DEFAULT_PASSWORD=""

JWT_SECRET=""
SESSION_MAX_AGE=""

API_URL="http://localhost:3333"
# production or development
API_ENV="development"
API_PORT="3333"

# Comma-separated CIDRs or IPs of reverse proxies whose X-Forwarded-For is trusted.
# Production behind Traefik: must contain the `edge` network subnet in docker/docker-compose.prod.yaml
TRUSTED_PROXIES=
# Public domain Traefik routes to the API
API_DOMAIN=""
# Let's Encrypt contact email
ACME_EMAIL=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

CORS_ALLOWED_ORIGINS=""
CORS_ALLOWED_METHODS=""

RATE_LIMIT_REQUESTS_PER_SECOND="20"
RATE_LIMIT_BURST="50"
RATE_LIMIT_CREDENTIALS_PER_MINUTE="5"
RATE_LIMIT_CREDENTIALS_BURST="10"

RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_CHANGE_REVERT_URL=""
EMAIL_OAUTH_LINK_REVERT_URL=""

OTEL_ENABLED=false
OTEL_SERVICE_NAME=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_TRACES_SAMPLER_ARG="1.0"
