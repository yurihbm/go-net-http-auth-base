  "cards": [
    {
      "dot": "emerald",
      "title": "Lean, no wrapper",
      "items": [
        "OTel SDK used directly; no domain Tracer/Meter interfaces",
        "otel imports only in telemetry, middlewares, logger, factories, postgres, cmd"
      ]
    },
    {
      "dot": "amber",
      "title": "Gating",
      "items": [
        "OTEL_ENABLED=false wires nothing and returns no-op providers",
        "GET /health and GET /ready produce no spans or metrics"
      ]
    },
    {
      "dot": "rose",
      "title": "Cardinality and PII",
      "items": [
        "Metrics carry only the route pattern, never the raw path",
        "Request UUID on spans only; query args never recorded"
      ]
    }
  ]
