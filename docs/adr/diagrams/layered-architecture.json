  "cards": [
    {
      "dot": "cyan",
      "title": "Dependency rule",
      "items": [
        "Interfaces and DTOs live in internal/domain",
        "Each layer depends on the next one's domain interface, never on a concrete type"
      ]
    },
    {
      "dot": "violet",
      "title": "Composition root",
      "items": [
        "NewDependencies builds repositories, services and middlewares once",
        "Thin per-controller factories pick from *Dependencies"
      ]
    },
    {
      "dot": "emerald",
      "title": "Transactions",
      "items": [
        "Services call Transactor.WithinTx",
        "TxAwareDB makes repositories join the tx carried in ctx"
      ]
    }
