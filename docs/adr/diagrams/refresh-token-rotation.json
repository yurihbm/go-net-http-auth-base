  "cards": [
    {
      "dot": "emerald",
      "title": "Sessions",
      "items": [
        "One user_sessions row per login (multi-device)",
        "expires_at = login + SESSION_MAX_AGE, never extended",
        "Login keeps at most MAX_SESSIONS_PER_USER (LRU evicted)"
      ]
    },
    {
      "dot": "rose",
      "title": "Reuse detection",
      "items": [
        "A stale jti, an expired session or a lost concurrent refresh deletes that session",
        "No grace window: clients must send one refresh at a time"
      ]
    },
    {
      "dot": "amber",
      "title": "Residual risk",
      "items": [
        "Access tokens are stateless and live up to 15 min after logout",
        "Refresh also re-checks that the user still exists"
      ]
    }
  ]
