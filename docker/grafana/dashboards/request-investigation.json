{
  "uid": "request-investigation",
  "title": "Request investigation",
  "tags": [
    "go-net-http-auth-base",
    "traces",
    "logs"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Dashboards",
      "tags": [
        "go-net-http-auth-base"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_name",
          "stream": "",
          "type": 1
        },
        "definition": "service_name",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "go-net-http-auth-base",
          "value": "go-net-http-auth-base"
        }
      },
      {
        "name": "request_uuid",
        "label": "Request UUID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Traces for the request UUID",
      "description": "Paste the X-Request-UUID response header in the Request UUID box. Click a trace ID to load it below. Traces can take about a minute to become searchable.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace in this dashboard",
                    "url": "/d/request-investigation?var-trace_id=${__data.fields.traceID}&${__url_time_range}&var-service=${service}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace in this dashboard",
                    "url": "/d/request-investigation?var-trace_id=${__data.fields.traceID}&${__url_time_range}&var-service=${service}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ span.app.request.uuid = \"$request_uuid\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 2,
      "type": "traces",
      "title": "Trace",
      "description": "Waterfall of the trace in the Trace ID box. Exceptions recorded on a span appear in its details.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "${trace_id}",
          "limit": 20
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Database queries in the trace",
      "description": "Database spans of the trace, named after the sqlc query.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ trace:id = \"$trace_id\" && span.db.system.name != nil } | select(name, span.db.operation.name, span.db.response.status_code)",
          "limit": 50,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs of the trace",
      "description": "Every log line emitted while the request was handled, with method, path, status, error and call site appended.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"$service\"} | trace_id=~\".+\" | trace_id=~\"$trace_id\" | line_format \"{{__line__}}{{if .method}} {{.method}} {{.path}} status={{.status}}{{end}}{{if .error}} error={{.error}}{{end}}{{if and .code_function_name (not .method)}} [{{.code_function_name}} {{.code_line_number}}]{{end}}\""
        }
      ]
    }
  ]
}
